# ─────────────────────────────────────────────────────────────────
# Trust Plumber — Environment Variables
# Copy this file to .env (and .env.local for local dev)
# ─────────────────────────────────────────────────────────────────

# Site URL (used for canonical tags, sitemap, OG images)
VITE_SITE_URL=https://trustplumber.ca

# Analytics (add when ready)
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=

# Call tracking (Phase 4)
VITE_CALLRAIL_ACCOUNT_ID=
VITE_CALLRAIL_SCRIPT_URL=

# Lead form backend (Phase 4)
VITE_LEADS_API_URL=
VITE_LEADS_API_KEY=
